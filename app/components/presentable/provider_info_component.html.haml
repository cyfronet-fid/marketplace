- if creators.present?
  .provider-panel
    .details-header
      %h5 Creators

    .card-body
      - creators.each do |creator|
        - if creator[:name].present?
          %dl
            %dt Name
            %dd= creator[:name]
        - if creator[:pid].present?
          %dl
            %dt PID
            %dd
              - if creator[:pid_url].present?
                = link_to creator[:pid], creator[:pid_url], target: "_blank", rel: "noopener"
              - else
                = creator[:pid]
        - next unless creator[:affiliation].present?
        %dl
          %dt Affiliation
          %dd= creator[:affiliation]
