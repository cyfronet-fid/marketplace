- if @base.respond_to?(:creators) && @base.creators.present?
  .provider-panel
    .details-header
      %h5 Creators

    .card-body
      - @base.creators.each do |creator|
        :ruby
          creator_name =
            if creator.is_a?(Hash)
              creator.dig("creatorNameTypeInfo", "creatorName") || creator["creatorName"] || creator["name"]
            else
              creator
            end
          creator_pid = creator["nameIdentifier"] if creator.is_a?(Hash)
          creator_affiliation = creator.dig("creatorAffiliationInfo", "affiliation") if creator.is_a?(Hash)
        - if creator_name.present?
          %dl
            %dt Name
            %dd= creator_name
        - if creator_pid.present?
          %dl
            %dt PID
            %dd
              - creator_pid_url = safe_creator_pid_url(creator_pid)
              - if creator_pid_url.present?
                = link_to creator_pid, creator_pid_url, target: "_blank", rel: "noopener"
              - else
                = creator_pid
        - next unless creator_affiliation.present?
        %dl
          %dt Affiliation
          %dd= creator_affiliation
