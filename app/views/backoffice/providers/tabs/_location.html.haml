.new-offer-form
  = simple_form_for [:backoffice, provider],
    html: { data: { controller: "form", form_target: "form", disabled: provider.upstream_id.present? } } do |f|
    = f.error_notification
    = hidden_field_tag :tab, "location"
    .row
      .col-lg-9.pl-0
        = f.input :country, disabled: cant_edit?(:country), as: :select,
                  collection: Country.options.map { |c| [ c.iso_short_name, "value" => c.alpha2 ] }
    .row.mt-4
      = f.button :submit, class: "btn btn-primary"
