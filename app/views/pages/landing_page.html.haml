%section.federated
  .container
    .federated-intro
      %h3
        Federated Catalogue
      %p.description
        The Federated Catalogue does not store services itself. Nodes keep their own catalogues and stay responsible for
        their own services. The catalogue collects information about them, so you can search everything in one place.
      %a.btn.btn-primary.mt-2{ href: "https://userspace.sandbox.eosc-beyond.eu/federation/services" } Discover Federated Catalogue

    .federated-media
      = image_tag "landing_page/federated-schema.png", alt: "Federated Catalogue", class: "img-fluid mt-5"


