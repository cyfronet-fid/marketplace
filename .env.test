### ARGO Messaging System (AMS)
# -----------------------------------------------------------------------------
AMS_BASE_URL=https://ams.example.com
AMS_SUBSCRIBE_ALL_CRON="*/5 * * * *"
AMS_SUBSCRIBE_ALL_ENABLED=true
AMS_SUBSCRIPTION_PREFIX=test
AMS_SUBSCRIPTIONS_PATH=/v1/projects/testproject/subscriptions
AMS_TOPICS_PATH=/v1/projects/testproject/topics
AMS_TOKEN=token

### Checkin (Keycloak) envs - MANDATORY
### ---------------------------------------------------------------------------
CHECKIN_HOST=keyclock.testhost
CHECKIN_ISSUER_URI=https://keyclock.testhost/realms/core
CHECKIN_SCOPE=openid,basic,profile,email,offline_access,aarc,entitlements
CHECKIN_DISCOVERY=true
CHECKIN_PKCE=true
CHECKIN_IDENTIFIER=identifier
CHECKIN_SECRET=secret
REDIRECT_URI=http://testhost/users/auth/checkin/callback

BECOME_VO_MEMBER_URL=https://example.com/enroll
VO_GROUP_NAME=testgroup

### Checkin (Keycloak) envs - MANDATORY if CHECKIN_DISCOVERY is false
### ---------------------------------------------------------------------------
# CHECKIN_AUTHORIZATION_ENDPOINT=/authorize
# CHECKIN_INTROSPECTION_ENDPOINT=/token/introspect
# CHECKIN_TOKEN_ENDPOINT=/token
# CHECKIN_USERINFO_ENDPOINT=/userinfo
# CHECKIN_JWKS_URI=/jwk
# CHECKIN_END_SESSION_ENDPOINT=/logout