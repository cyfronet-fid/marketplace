### Dummy values for the test environment (loaded by dotenv-rails).
### Under the whitelabel variant config/initializers/devise.rb fetches these
### without a default, so the application cannot boot without them.
### ---------------------------------------------------------------------------
CHECKIN_ISSUER_URI=https://checkin.test/realms/core
CHECKIN_HOST=checkin.test
CHECKIN_IDENTIFIER=dummy
CHECKIN_SECRET=dummy
REDIRECT_URI=http://localhost:3000/users/auth/checkin/callback
