### Deployment variant and frontend customization
### ---------------------------------------------------------------------------
# The variant is one of: marketplace, pl, whitelabel (config/variants.yml).
# Production needs the variable. Development and test default to marketplace.
# CUSTOMIZATION_PATH is the absolute path of the frontend of a deployment.
# The application reads views, config/locales, locale, images and
# config/breadcrumbs from this directory at boot. `yarn build` and
# `yarn build:css` read javascript and stylesheets from this directory.
# marketplace runs without CUSTOMIZATION_PATH and uses the repository frontend.
# Do not set the two variables in this file when you start a variant with
# lib/versions/run_variant_env.sh. The script exports them together with
# DATABASE_URL, ELASTICSEARCH_URL, REDIS_URL and SCHEMA, and foreman gives the
# values in this file priority over exported values.
# MARKETPLACE_VARIANT=pl
# CUSTOMIZATION_PATH=/path/to/marketplace/customization/pl

### Local development: web port and login
### ---------------------------------------------------------------------------
# bin/dev starts the web server on PORT (default 3000). The scripts in
# lib/versions and the smoke test use the port from this file.
PORT=5000
# AUTH_MOCK=true turns on GET /users/login in development. The route signs a
# user in without Check-in. A new email creates the user with the roles from
# the query: roles[]=admin&roles[]=coordinator&roles[]=executive.
AUTH_MOCK=true

### EOSC Commons header and footer
### ---------------------------------------------------------------------------
# The pl layouts show the shared EOSC Commons header and footer when
# ENABLE_COMMONS is true. When ENABLE_COMMONS is false, the pl layouts show
# the header of the deployment with its own logo. The repository layouts
# always show the EOSC Commons header and footer.
# ENABLE_COMMONS=true
# EOSC_COMMONS_BASE_URL=https://s3.cloud.cyfronet.pl/eosc-portal-common/
# EOSC_COMMONS_ENV=production
# RECAPTCHA_ENABLED=false turns the reCAPTCHA widget off for a run without keys.
# RECAPTCHA_ENABLED=true

### ARGO Messaging System (AMS)
# -----------------------------------------------------------------------------
AMS_BASE_URL=https://<YOUR_AMS_HOST>
AMS_SUBSCRIBE_ALL_CRON="*/5 * * * *"
AMS_SUBSCRIBE_ALL_ENABLED=true
AMS_SUBSCRIPTION_PREFIX=<YOUR_PREFIX>
AMS_SUBSCRIPTIONS_PATH=/v1/projects/<YOUR_PROJECT>/subscriptions
AMS_TOPICS_PATH=/v1/projects/<YOUR_PROJECT>/topics
AMS_TOKEN=<YOUR_TOKEN>

### Deployable services (Application Deployment Manager)
### ---------------------------------------------------------------------------
# # ADM API base URL (keep the trailing slash)
# ADM_BASE_URL=https://deploy.sandbox.eosc-beyond.eu/adim/

# # Timeout of an ADM request, in seconds
# ADM_TIMEOUT=60

# # Timeout of opening a connection to ADM, in seconds
# ADM_OPEN_TIMEOUT=10

# # Cloud site of new deployments, a key of cloud_sites in config/adm.yml
# ADM_DEFAULT_CLOUD=IISAS-FedCloud

# # OpenStack Keystone endpoint of the IISAS-FedCloud site
# ADM_CLOUD_HOST=https://cloud.ui.savba.sk:5000

# # OpenStack project ID of the IISAS-FedCloud site
# ADM_CLOUD_DOMAIN=<YOUR_PROJECT_ID>

# # EGI AAI (not EOSC Check-in) service account refresh token, exchanged for ADM access tokens
EGI_REFRESH_ACCESS_TOKEN=<YOUR_REFRESH_TOKEN>

# # EGI AAI access token used as is instead of a refreshed one
# EGI_ACCESS_TOKEN=<YOUR_ACCESS_TOKEN>

# # EGI AAI endpoint that exchanges the refresh token for an access token
# EGI_REFRESH_TOKEN_URL=https://aai.egi.eu/auth/realms/egi/protocol/openid-connect/token

# # OAuth client ID the refresh token was issued for
# EGI_CLIENT_ID=token-portal

# # Minutes a refreshed access token stays cached
# EGI_TOKEN_CACHE_EXPIRY=50

# # Polls ADM for the state of deployments, which are asynchronous (only true turns it on)
INFRASTRUCTURE_POLLING_ENABLED=true

# # Cron schedule of the deployment state polling
INFRASTRUCTURE_POLLING_CRON="* * * * *"

### Checkin (Keycloak) envs - MANDATORY under MARKETPLACE_VARIANT=marketplace
### and MARKETPLACE_VARIANT=whitelabel (pl has defaults and a credentials fallback)
### ---------------------------------------------------------------------------
CHECKIN_HOST=<YOUR_KEYCLOAK_HOST>
CHECKIN_ISSUER_URI=<YOUR_KEYCLOAK_ISSUER_URI>
# Default under whitelabel: openid,basic,profile,email,offline_access
CHECKIN_SCOPE=openid,basic,profile,email,offline_access,aarc,entitlements
CHECKIN_DISCOVERY=true
CHECKIN_PKCE=true
CHECKIN_IDENTIFIER=<YOUR_IDENTIFIER>
CHECKIN_SECRET=<YOUR_SECRET>
REDIRECT_URI=https://<YOUR_DOMAIN_NAME>/users/auth/checkin/callback

### VO membership check of the order flow - MANDATORY under marketplace
### ---------------------------------------------------------------------------
BECOME_VO_MEMBER_URL=<YOUR_BECOME_VO_MEMBER_URL>
VO_GROUP_NAME=<YOUR_VO_GROUP_NAME>

### Checkin (Keycloak) envs - MANDATORY if CHECKIN_DISCOVERY is false
### ---------------------------------------------------------------------------
# CHECKIN_AUTHORIZATION_ENDPOINT=<YOUR_KEYCLOAK_ISSUER_URI>/authorize
# CHECKIN_INTROSPECTION_ENDPOINT=<YOUR_KEYCLOAK_ISSUER_URI>/token/introspect
# CHECKIN_TOKEN_ENDPOINT=<YOUR_KEYCLOAK_ISSUER_URI>/token
# CHECKIN_USERINFO_ENDPOINT=<YOUR_KEYCLOAK_ISSUER_URI>/userinfo
# CHECKIN_JWKS_URI=<YOUR_KEYCLOAK_ISSUER_URI>/jwk
# CHECKIN_END_SESSION_ENDPOINT=<YOUR_KEYCLOAK_ISSUER_URI>/logout

### Checkin under MARKETPLACE_VARIANT=pl - all optional
### ---------------------------------------------------------------------------
# pl uses the EOSC Check-in defaults below. When CHECKIN_IDENTIFIER and
# CHECKIN_SECRET are unset, pl reads them from config/credentials.yml.enc.
# pl names the endpoint variables differently from the block above. The
# default scope is openid,profile,email,aarc,offline_access. PKCE is off if
# CHECKIN_PKCE is unset. When REDIRECT_URI is unset, pl uses
# ROOT_URL/users/auth/checkin/callback.
# CHECKIN_HOST=aai.eosc-portal.eu
# CHECKIN_ISSUER_ENDPOINT=auth/realms/core
# CHECKIN_AUTHORIZE_ENDPOINT=/auth/realms/core/protocol/openid-connect/auth
# CHECKIN_TOKEN_ENDPOINT=/auth/realms/core/protocol/openid-connect/token
# CHECKIN_USERINFO_ENDPOINT=/auth/realms/core/protocol/openid-connect/userinfo
# CHECKIN_JWK_ENDPOINT=/auth/realms/core/protocol/openid-connect/certs
# ROOT_URL=http://localhost:5000

### Import under whitelabel: a client credentials token is always fetched
### when MP_IMPORT_TOKEN is blank
# -----------------------------------------------------------------------------
# IMPORT_CLIENT_ID=<YOUR_IDENTIFIER>
# IMPORT_CLIENT_SECRET=<YOUR_SECRET>

### Mail - all optional in development
### ---------------------------------------------------------------------------
# config/environments/production.rb reads the SMTP settings; development
# sends to localhost:1025. FROM_EMAIL is the sender of the mails
# (app/mailers/application_mailer.rb). SMTP_STARTTLS=false turns STARTTLS
# off. SMTP_AUTHENTICATION selects the authentication method, default plain.
# SMTP_ADDRESS=<YOUR_SMTP_HOST>
# SMTP_PORT=587
# SMTP_USERNAME=<YOUR_SMTP_USER>
# SMTP_PASSWORD=<YOUR_SMTP_PASSWORD>
# SMTP_STARTTLS=true
# FROM_EMAIL=<SENDER_ADDRESS>
