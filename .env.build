### Dummy values for Docker build-time asset precompilation only.
### Under the whitelabel variant config/initializers/devise.rb fetches these
### without a default, so `rails assets:precompile` cannot boot without them.
### Not used at runtime.
### ---------------------------------------------------------------------------
CHECKIN_ISSUER_URI=https://build.invalid/realms/core
CHECKIN_HOST=build.invalid
CHECKIN_IDENTIFIER=dummy
CHECKIN_SECRET=dummy
REDIRECT_URI=https://build.invalid/users/auth/checkin/callback
