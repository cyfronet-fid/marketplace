{
  "openapi": "3.0.1",
  "info": {
    "title": "EOSC Marketplace Statistics API",
    "version": "v1",
    "description": "Service statistics of this Node for the Resource Catalogue, by PID. Any user token reads them; no role is needed. The figures are all-time and match the ones ESS sends."
  },
  "paths": {
    "/api/v1/statistics/services": {
      "get": {
        "summary": "lists the statistics of Services, a page at a time",
        "tags": [
          "Service statistics"
        ],
        "security": [
          {
            "authentication_token": []
          }
        ],
        "parameters": [
          {
            "name": "from_id",
            "in": "query",
            "required": false,
            "description": "List the Services with an id greater than from_id, 0 by default: next_from_id of the previous page",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Services on a page, 100 by default and 1000 at most",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "pid[]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 100
            },
            "description": "Only the Services with these PIDs, 100 at most. A PID that the Node doesn't publish (no published or errored Service has it) is left out of the page, with no error."
          }
        ],
        "responses": {
          "200": {
            "description": "a page of statistics found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "statistics/service_statistics_index.json"
                }
              }
            }
          },
          "400": {
            "description": "from_id, limit or pid[] not valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "error.json"
                }
              }
            }
          },
          "401": {
            "description": "user not recognized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "error.json"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/statistics/services/{pid}": {
      "parameters": [
        {
          "name": "pid",
          "in": "path",
          "description": "PID of the Service, which may contain one /",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "summary": "retrieves the statistics of a Service",
        "tags": [
          "Service statistics"
        ],
        "security": [
          {
            "authentication_token": []
          }
        ],
        "responses": {
          "200": {
            "description": "statistics found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "statistics/service_statistics_read.json"
                }
              }
            }
          },
          "404": {
            "description": "the Node publishes no Service with the PID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "error.json"
                }
              }
            }
          },
          "401": {
            "description": "user not recognized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "error.json"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "authentication_token": {
        "type": "apiKey",
        "name": "X-User-Token",
        "in": "header"
      }
    }
  }
}