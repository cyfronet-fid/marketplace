{
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "order_type": {
      "type": "string",
      "enum": [
        "open_access",
        "fully_open_access",
        "order_required",
        "other"
      ]
    },
    "offer_category": {
      "type": "string",
      "enum": [
        "service_category-compute",
        "service_category-data_source",
        "service_category-storage",
        "service_category-training",
        "service_category-other"
      ]
    },
    "primary_oms_id": {
      "type": "integer"
    },
    "oms_params": {
      "type": "object"
    },
    "order_url": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "internal": {
      "type": "boolean"
    },
    "bundled_offers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "object"
          }
        ]
      }
    },
    "parameters": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/attribute_parameter"
          },
          {
            "$ref": "#/components/schemas/input_parameter"
          },
          {
            "$ref": "#/components/schemas/select_parameter"
          },
          {
            "$ref": "#/components/schemas/multiselect_parameter"
          },
          {
            "$ref": "#/components/schemas/date_parameter"
          },
          {
            "$ref": "#/components/schemas/range_parameter"
          },
          {
            "$ref": "#/components/schemas/quantity_price_parameter"
          }
        ]
      }
    }
  },
  "not": {
    "required": [
      "status"
    ]
  }
}
