- if service.webpage_url.present?
  = link_to _("Visit the Service"), service.webpage_url, target: "_blank", class: "btn btn-primary d-block mb-3 py-2"

- case params[:from]
- when "ordering_configuration"
  = link_to _("Back to the service"), service_offers_path(service), class: "btn btn-primary d-block mb-3"
  = link_to _("Set parameters and offers"), service_ordering_configuration_path(service, anchor: "offers", from: params[:from]), class: "btn btn-outline-secondary d-block mb-3 no-arrow"
- when "backoffice_service"
  - if policy([:backoffice, service]).edit?
    = link_to _("Edit #{service.type.downcase}"), edit_backoffice_service_path(service), class: "btn btn-primary d-block mb-3"
    = link_to _("Set parameters and offers"), backoffice_service_offers_path(service, anchor: "offers"), class: "btn btn-outline-primary d-block mb-3"
- else
  - if (local_assigns[:preview] && service.offers?) || policy(ServiceContext.new(service, params[:from] == "backoffice_service")).order?
    = link_to _("Order the service"), service_choose_offer_path(service), class: "btn btn-outline-secondary d-block mb-3 py-2"
  - if user_signed_in? && show_manage_button?(service)
    %a#dropdown-menu-button.dropdown-toggle.btn.btn-outline-secondary.d-block.mb-3{ "aria-expanded" => "false", "aria-haspopup" => "true", "data-toggle" => "dropdown", type: "button" }
      .menu__label Manage the service
    .dropdown-menu.shadow
      %ul
        %li
          - url = "#{providers_dashboard_url}/dashboard/#{catalogue_pid(service)}/#{resource_organisation_pid(service)}/resource-dashboard/#{service.pid}/stats"
          = link_to _("Services dashboard"), url, target: "_blank", class: "dropdown-item dropdown-details"
        - if catalogue_pid(service) == "eosc"
          %li
            - url = "#{providers_dashboard_url}/provider/#{resource_organisation_pid(service)}/resource/update/#{service.pid}"
            = link_to _("Edit service details"), url, target: "_blank", class: "dropdown-item dropdown-details"
        %li
          = link_to _("Set parameters and offers"), service_ordering_configuration_path(service, anchor: "offers", from: params[:from]), class: "dropdown-item dropdown-details"

= render "layouts/common_parts/services/order_type_label", object: service
